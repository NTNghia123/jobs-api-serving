# Sao chép thành .env cho môi trường local. KHÔNG commit file .env.
JOBS_API_ENV=local
JOBS_API_LOG_LEVEL=INFO
JOBS_API_LOG_FORMAT=text          # dùng json ở staging/prod
JOBS_API_WAREHOUSE_BACKEND=fake   # khả dụng: fake | bigquery | duckdb
JOBS_API_BQ_PROJECT=              # bắt buộc khi backend=bigquery
JOBS_API_BQ_DATASET=              # vd jobs_staging hoặc jobs_prod; bắt buộc khi backend=bigquery
JOBS_API_BQ_LOCATION=asia-southeast1
JOBS_API_BQ_MAXIMUM_BYTES_BILLED=2000000000
JOBS_API_PAGE_TOKEN_SECRET=dev-only-insecure-secret
JOBS_API_CACHE_BACKEND=memory     # quick-start: memory (không cần Redis). Đổi 'redis' khi có Memorystore.
JOBS_API_REDIS_URL=redis://localhost:6379/0   # chỉ dùng khi CACHE_BACKEND/RATE_LIMITER_BACKEND=redis

# ★ THÊM Ở TUẦN 3
JOBS_API_DUCKDB_PATH=analytics.duckdb
# CHỈ script ELT dùng chuỗi này (user chỉ-đọc). API không đọc.
JOBS_API_MYSQL_URL=mysql+pymysql://reader:reader_pw@localhost:3306/jobportal

# ★ THÊM Ở TUẦN 6 — xác thực & rate-limit
# Local: để trống JOBS_API_API_KEYS → store tự seed key dev "dev-local-key-team-ai"
#        (client_id=team-ai-dev). Gửi kèm header: "X-API-Key: dev-local-key-team-ai".
# Prod: BẮT BUỘC đặt, dạng JSON, chỉ chứa HASH (sinh bằng: python -m scripts.issue_key <client>):
#   JOBS_API_API_KEYS={"team-ai":{"key_sha256":"<sha256 hex>","expires_at":"2026-12-31T00:00:00Z"}}
JOBS_API_API_KEYS={}
JOBS_API_RATE_LIMIT_PER_MINUTE=120
JOBS_API_RATE_LIMIT_BURST=0

# ★ THÊM Ở TUẦN 7 — triển khai container
# Config đã 12-factor sẵn từ các tuần trước: MỌI thứ khác nhau giữa local/staging/prod đều đọc
# từ biến JOBS_API_* ở đây, không hard-code. settings.py đã FAIL-FAST khi env != local mà:
#   - JOBS_API_PAGE_TOKEN_SECRET còn là giá trị dev mặc định, hoặc
#   - JOBS_API_API_KEYS rỗng.
# Trong docker-compose.yml, service 'api' được truyền sẵn các biến trên; file .env này là cho chạy
# trực tiếp (không container). PROD: lấy secret từ Secret Manager, KHÔNG để trong .env.
#
# Rate-limit chọn backend: memory (mặc định, 1 instance) | redis (chia sẻ đa instance, ADR-017).
JOBS_API_RATE_LIMITER_BACKEND=memory
# Ngân sách timeout LỒNG NHAU: client (vd 30s) > request > query. Validator ép query < request (ADR-016).
JOBS_API_REQUEST_TIMEOUT_S=20
JOBS_API_QUERY_TIMEOUT_S=10       # BigQuery: result(timeout) rồi cancel; DuckDB: interrupt

# ★ THÊM Ở TUẦN 8 — tracing OpenTelemetry (ADR-027)
# exporter: none (mặc định — test/local không tracing) | console (dev, in span ra stdout) |
#           otlp (Cloud Run → Telemetry API → Cloud Trace).
JOBS_API_OTEL_TRACES_EXPORTER=none
# Tỷ lệ sample [0.0..1.0]. Mặc định 0.1; ĐẶT 1.0 khi demo/nghiệm thu để chắc có trace.
JOBS_API_OTEL_SAMPLING_RATIO=0.1
